# Base URL the browser uses for data requests.
# Defaults to this application's own API routes.
NEXT_PUBLIC_API_BASE_URL=/api

# Read-only upstream API the server mirrors data from (server-side only).
UPSTREAM_API_BASE_URL=https://dummyjson.com

# File name inside the .data/ directory holding locally created/updated/deleted records.
LOCAL_DATA_FILE_NAME=overlay.json
